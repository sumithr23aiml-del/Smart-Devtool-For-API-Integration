      {% endif %}
    {% endfor %}
    {# 2. Required body params #}
    {% for param in endpoint.parameters %}
      {% if param.name != authentication.query_parameter and param.name != authentication.header_name %}
        {% if param.required and param.location == 'body' %}
          {% set _ = ns.sorted_params.append(param) %}
        {% endif %}
      {% endif %}
    {% endfor %}
    {# 3. Required other params #}
    {% for param in endpoint.parameters %}
      {% if param.name != authentication.query_parameter and param.name != authentication.header_name %}
        {% if param.required and param.location not in ['path', 'body'] %}
          {% set _ = ns.sorted_params.append(param) %}
        {% endif %}
      {% endif %}
    {% endfor %}
    {# 4. Optional body params #}
    {% for param in endpoint.parameters %}
      {% if param.name != authentication.query_parameter and param.name != authentication.header_name %}
        {% if not param.required and param.location == 'body' %}
          {% set _ = ns.sorted_params.append(param) %}
        {% endif %}
      {% endif %}
    {% endfor %}
    {# 5. Optional query params #}
    {% for param in endpoint.parameters %}
      {% if param.name != authentication.query_parameter and param.name != authentication.header_name %}
        {% if not param.required and param.location == 'query' %}
          {% set _ = ns.sorted_params.append(param) %}
        {% endif %}
      {% endif %}
    {% endfor %}
    {# 6. Optional other params #}
    {% for param in endpoint.parameters %}
      {% if param.name != authentication.query_parameter and param.name != authentication.header_name %}
        {% if not param.required and param.location not in ['body', 'query'] %}
          {% set _ = ns.sorted_params.append(param) %}
        {% endif %}
      {% endif %}
    {% endfor %}
    {% set has_stream_param = namespace(found=false) %}
    {% for param in endpoint.parameters %}
      {% if param.name == 'stream' %}
        {% set has_stream_param.found = true %}
      {% endif %}
    {% endfor %}
    def {{ endpoint.name }}(
        self,
        {% for param in ns.sorted_params %}
        {% set ptype = 'Any' if param.type in ['object', 'dict'] else 'list' if param.type == 'array' else 'float' if param.type in ['float', 'number'] else 'int' if param.type in ['int', 'integer'] else 'bool' if param.type in ['bool', 'boolean'] else 'str' %}
        {% if param.required %}
        {{ param.name }}: {{ ptype }},
        {% else %}
        {{ param.name }}: Optional[{{ ptype }}] = None,
        {% endif %}
        {% endfor %}
        {% if not has_stream_param.found %}
        stream: bool = False,
        {% endif %}
    ) -> Any:
        """{{ endpoint.summary or endpoint.description or 'No description provided.' }}
        {% if ns.sorted_params or not has_stream_param.found %}

        Args:
            {% for param in ns.sorted_params %}
            {% set ptype = 'dict' if param.type in ['object', 'dict'] else 'list' if param.type == 'array' else 'float' if param.type in ['float', 'number'] else 'int' if param.type in ['int', 'integer'] else 'bool' if param.type in ['bool', 'boolean'] else 'str' %}
            {{ param.name }} ({{ ptype }}{% if not param.required %}, optional{% endif %}): {{ param.description or 'No description provided.' }}
            {% endfor %}
            {% if not has_stream_param.found %}
            stream (bool, optional): Whether to stream the response content. Defaults to False.
            {% endif %}
        {%- endif %}

        Returns:
            Any: The parsed API response.

        Raises:
            ValueError: If a required parameter is missing.
            ApiClientError: If the request fails.
        """
        {% for param in ns.sorted_params %}
        {% if param.required %}
        if {{ param.name }} is None:
            raise ValueError("{{ param.name }} is required.")
        {% endif %}
        {% endfor %}
        {% if '{' in endpoint.path %}
        path = f"{{ endpoint.path }}"
        {% else %}
        path = "{{ endpoint.path }}"
        {% endif %}

        {% set query_params = endpoint.parameters | selectattr('location', 'equalto', 'query') | list %}
        {% if query_params %}
        params = {}
        {% for param in query_params %}
        {% if param.name != authentication.query_parameter and param.name != authentication.header_name %}
        if {{ param.name }} is not None:
            params["{{ param.name }}"] = {{ param.name }}
        {% endif %}
        {% endfor %}
        if not params:
            params = None
        {% else %}
        params = None
        {% endif %}

        {% set body_params = endpoint.parameters | selectattr('location', 'equalto', 'body') | list %}
        {% if body_params %}
        json_data = {}
        {% for param in body_params %}
        {% if param.name != authentication.query_parameter and param.name != authentication.header_name %}
        if {{ param.name }} is not None:
            json_data["{{ param.name }}"] = {{ param.name }}
        {% endif %}
        {% endfor %}
        if not json_data:
            json_data = None
        {% else %}
        json_data = None
        {% endif %}

        {% set header_params = endpoint.parameters | selectattr('location', 'equalto', 'header') | list %}
        {% if header_params %}
        headers = {}
        {% for param in header_params %}
        {% if param.name != authentication.query_parameter and param.name != authentication.header_name %}
        if {{ param.name }} is not None:
            headers["{{ param.name }}"] = {{ param.name }}
        {% endif %}
        {% endfor %}
        if not headers:
            headers = None
        {% else %}
        headers = None
        {% endif %}

        {% set cookie_params = endpoint.parameters | selectattr('location', 'equalto', 'cookie') | list %}
        {% if cookie_params %}
        cookies = {}
        {% for param in cookie_params %}
        {% if param.name != authentication.query_parameter and param.name != authentication.header_name %}
