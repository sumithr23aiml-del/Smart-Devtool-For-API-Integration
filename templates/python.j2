import os
import time
from typing import Any, Dict, List, Optional
import requests

class ApiClientError(Exception):
    """Exception raised for errors in the {{ api_name }}Client."""
    def __init__(
        self,
        message: str,
        status_code: Optional[int] = None,
        response_text: Optional[str] = None,
    ) -> None:
        super().__init__(message)
        self.status_code = status_code
        self.response_text = response_text

class {{ api_name }}Client:
    """Client wrapper for {{ api_name }} API.
    """

    def __init__(
        self,
        base_url: str = "{{ base_url }}",
        api_key: Optional[str] = None,
        timeout: int = {{ timeout or timeouts or 30 }},
    ) -> None:
        """Initializes the {{ api_name }}Client.

        Args:
            base_url: Override the default API base URL.
            api_key: The authorization key/token. If not provided, it will be
                fetched from the environment variables.
            timeout: Default request timeout in seconds.
        """
        self.base_url = base_url.rstrip("/")
        self.timeout = timeout
        
        # Load API key
        {% if authentication.type != 'none' %}
        env_var = "{{ environment_variable or (api_name | upper) ~ '_API_KEY' }}"
        self.api_key = api_key or os.getenv(env_var)
        if not self.api_key:
            raise ValueError(
                f"API key is required. Provide it explicitly or set the "
                f"environment variable: {env_var}"
            )
        {% else %}
        self.api_key = None
        {% endif %}

        self.session = requests.Session()
        self.session.headers.update({"Accept": "application/json"})

        # Configure authentication
        {% if authentication.type in ['bearer_token', 'bearer', 'oauth2'] %}
        self.session.headers.update({"Authorization": f"Bearer {self.api_key}"})
        {% elif authentication.type == 'jwt' %}
        self.session.headers.update({"Authorization": f"JWT {self.api_key}"})
        {% elif authentication.type == 'api_key_header' %}
        header_name = "{{ authentication.header_name or 'X-API-Key' }}"
        self.session.headers.update({header_name: self.api_key})
        {% elif authentication.type == 'basic_auth' %}
        self.session.headers.update({"Authorization": f"Basic {self.api_key}"})
        {% elif authentication.type == 'cookie' %}
        cookie_name = "{{ authentication.cookie_name or 'session_id' }}"
        self.session.cookies.set(cookie_name, self.api_key)
        {% endif %}

    def _request(
        self,
        method: str,
        path: str,
        params: Optional[Dict[str, Any]] = None,
        json_data: Optional[Dict[str, Any]] = None,
        headers: Optional[Dict[str, Any]] = None,
        cookies: Optional[Dict[str, Any]] = None,
        data: Optional[Dict[str, Any]] = None,
        files: Optional[Dict[str, Any]] = None,
        stream: bool = False,
    ) -> Any:
        """Executes an HTTP request with automatic retries and checks for errors.

        Args:
            method: HTTP method (GET, POST, etc.).
            path: Relative API path.
            params: Query parameters dictionary.
            json_data: JSON request body dictionary.
            headers: Request-specific headers.
            cookies: Request-specific cookies.
            data: Request-specific form data.
            files: Request-specific file streams.
            stream: Whether to stream the response content.

        Returns:
            The parsed JSON response, binary content, raw text, or raw streaming response.

        Raises:
            ApiClientError: If the request fails or response status code indicates an error.
        """
        url = f"{self.base_url}{path}"
        
        if params is None:
            params = {}

        # Automatically inject API key in query if query-based auth is used
        {% if authentication.type == 'api_key_query' %}
        query_parameter = "{{ authentication.query_parameter or 'api_key' }}"
        if self.api_key:
            params[query_parameter] = self.api_key
        {% endif %}

        req_headers = {}
        if headers:
            req_headers.update(headers)

        max_attempts = 4  # 1 initial request + 3 retries
        backoff_base = 1.0

        for attempt in range(max_attempts):
            try:
                response = self.session.request(
                    method=method,
                    url=url,
                    params=params,
                    json=json_data,
                    data=data,
                    files=files,
                    headers=req_headers if req_headers else None,
                    cookies=cookies,
                    timeout=self.timeout,
                    stream=stream,
                )

                # Retry on specific transient error codes if attempts are remaining
                if response.status_code in [429, 500, 502, 503, 504]:
                    if attempt < max_attempts - 1:
                        sleep_time = backoff_base * (2**attempt)
                        time.sleep(sleep_time)
                        continue

                response.raise_for_status()
                
                if response.status_code == 204:
                    return {}

                # Stream response
                if stream or "text/event-stream" in response.headers.get("content-type", "").lower():
                    return response

                content_type = response.headers.get("content-type", "").lower()
                if "application/json" in content_type:
                    try:
                        return response.json()
                    except ValueError:
                        return response.text
                elif "text/" in content_type:
                    return response.text
                elif any(binary_type in content_type for binary_type in ["octet-stream", "image/", "audio/", "video/", "pdf", "zip"]):
                    return response.content
                
                try:
                    return response.json()
                except ValueError:
                    return response.text

            except requests.exceptions.HTTPError as e:
                raise ApiClientError(
                    message=f"HTTP error occurred: {e}",
                    status_code=e.response.status_code if e.response is not None else None,
                    response_text=e.response.text if e.response is not None else None
                ) from e
            except requests.exceptions.RequestException as e:
                raise ApiClientError(message=f"Request failed: {e}") from e

    {% for endpoint in endpoints %}
    {% set ns = namespace(sorted_params=[]) %}
    {# 1. Required path params #}
    {% for param in endpoint.parameters %}
      {% if param.name != authentication.query_parameter and param.name != authentication.header_name %}
        {% if param.required and param.location == 'path' %}
