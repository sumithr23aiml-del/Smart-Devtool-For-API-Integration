    {% set has_pagination = namespace(found=false, param_name=none, type=none) %}
    {% for param in endpoint.parameters %}
      {% if param.location == 'query' and param.name in ['starting_after', 'cursor', 'page', 'offset', 'next_page_token'] %}
        {% set has_pagination.found = true %}
        {% set has_pagination.param_name = param.name %}
        {% set has_pagination.type = param.name %}
      {% endif %}
    {% endfor %}
    {% if has_pagination.found and endpoint.method == 'GET' %}

    def {{ endpoint.name }}_iter(
        self,
        {% for param in ns.sorted_params %}
        {% set ptype = 'Any' if param.type in ['object', 'dict'] else 'list' if param.type == 'array' else 'float' if param.type in ['float', 'number'] else 'int' if param.type in ['int', 'integer'] else 'bool' if param.type in ['bool', 'boolean'] else 'str' %}
        {% if param.required %}
        {{ param.name }}: {{ ptype }},
        {% else %}
        {{ param.name }}: Optional[{{ ptype }}] = None,
        {% endif %}
        {% endfor %}
    ) -> Any:
        """Helper generator to iterate over all pages of {{ endpoint.name }} yielding items.
        """
        current_params = {
            {% for param in ns.sorted_params %}
            "{{ param.name }}": {{ param.name }},
            {% endfor %}
        }
        
        while True:
            response = self.{{ endpoint.name }}(**current_params)
            
            if isinstance(response, list):
                items = response
            elif isinstance(response, dict):
                items = None
                for key in ["data", "items", "results", "objects"]:
                    if key in response and isinstance(response[key], list):
                        items = response[key]
                        break
                if items is None:
                    for val in response.values():
                        if isinstance(val, list):
                            items = val
                            break
                if items is None:
                    items = [response]
            else:
                items = [response]
                
            if not items:
                break
                
            for item in items:
                yield item
                
            {% if 'page' in has_pagination.type %}
            if current_params.get("{{ has_pagination.param_name }}") is None:
                current_params["{{ has_pagination.param_name }}"] = 1
            current_params["{{ has_pagination.param_name }}"] += 1
            {% elif 'offset' in has_pagination.type %}
            if current_params.get("{{ has_pagination.param_name }}") is None:
                current_params["{{ has_pagination.param_name }}"] = 0
            current_params["{{ has_pagination.param_name }}"] += len(items)
            {% elif 'starting_after' in has_pagination.type %}
            last_item = items[-1]
            if isinstance(last_item, dict) and "id" in last_item:
                current_params["{{ has_pagination.param_name }}"] = last_item["id"]
            else:
                break
            {% else %}
            next_cursor = None
            if isinstance(response, dict):
                next_cursor = response.get("next_cursor") or response.get("next_page_token") or response.get("next_link")
            if not next_cursor:
                break
            current_params["{{ has_pagination.param_name }}"] = next_cursor
            {% endif %}
    {% endif %}
    {% endfor %}
