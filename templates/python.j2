        {% else %}
        cookies = None
        {% endif %}

        {% set form_params = endpoint.parameters | selectattr('location', 'equalto', 'form') | list %}
        {% if form_params %}
        data = {}
        files = {}
        {% for param in form_params %}
        {% if param.name != authentication.query_parameter and param.name != authentication.header_name %}
        if {{ param.name }} is not None:
            if isinstance({{ param.name }}, (bytes, bytearray)) or hasattr({{ param.name }}, "read") or "{{ param.name }}" in ["file", "files"] or "{{ param.type }}" == "binary":
                files["{{ param.name }}"] = {{ param.name }}
            else:
                data["{{ param.name }}"] = {{ param.name }}
        {% endif %}
        {% endfor %}
        if not data:
            data = None
        if not files:
            files = None
        {% else %}
        data = None
        files = None
        {% endif %}

        return self._request(
            method="{{ endpoint.method }}",
            path=path,
            params=params,
            json_data=json_data,
            headers=headers,
            cookies=cookies,
            data=data,
            files=files,
